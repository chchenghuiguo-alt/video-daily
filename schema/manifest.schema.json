{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "video-daily day manifest.json (schema_version 2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "date", "timezone", "episode", "status", "selection", "items", "order", "total_bytes", "updated_at"],
  "properties": {
    "schema_version": {"const": 2},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "timezone": {"const": "Asia/Singapore"},
    "episode": {"type": "integer", "minimum": 1, "description": "建议期号 = 上一期已发布的 episode + 1；最终以 _output/publish.json 为准"},
    "status": {"enum": ["pending", "ready"], "description": "pending 上传中；ready 全部上传完成（最后一个提交才改成 ready）"},
    "selection": {"enum": ["unknown", "selected"], "description": "unknown = 用户还没选，order 为空，剪辑方自行挑选或等通知"},
    "items": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "title", "selected", "bytes"],
        "properties": {"id": {"type": "string", "pattern": "^[0-9]{3}$"}, "title": {"type": "string"},
          "selected": {"type": ["boolean", "null"]}, "bytes": {"type": "integer"},
          "has_video": {"type": "boolean"}, "duration": {"type": ["number", "null"]}}}
    },
    "order": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]{3}$"}, "description": "合集剪辑顺序；selection=unknown 时为 []"},
    "total_bytes": {"type": "integer"},
    "updated_at": {"type": "string", "format": "date-time"},
    "notes": {"type": "string"}
  }
}
